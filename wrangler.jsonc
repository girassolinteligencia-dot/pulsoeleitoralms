{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulso-eleitoral",
  "main": "worker.ts", // app OpenNext + scheduled (Cron)
  // `wrangler deploy` (local ou Workers Builds) gera o bundle OpenNext antes de publicar.
  "build": { "command": "npx opennextjs-cloudflare build" },
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "pulso-eleitoral" },
  ],
  "routes": [
    { "pattern": "pulsoms.ia.br", "custom_domain": true },
    { "pattern": "www.pulsoms.ia.br", "custom_domain": true },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pulso-db",
      "database_id": "a10eace2-40a9-4850-8490-b9b9bebd164e",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "pulso-fotos" }],
  "kv_namespaces": [
    { "binding": "KV", "id": "fef8e33fb2b147449bbf5402b08ebe8f" },
  ],
  // Rate limit global (período: 10 ou 60 s). namespace_id é único por conta.
  "ratelimits": [
    {
      "name": "RL_SESSAO",
      "namespace_id": "71001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "RL_ENVIO",
      "namespace_id": "71002",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "RL_PUBLICO",
      "namespace_id": "71003",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  // Cron: resumos a cada 15 min; retenção LGPD diária (07:00 UTC = 03:00 em Campo Grande)
  "triggers": { "crons": ["*/15 * * * *", "0 7 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://pulsoms.ia.br",
    "AUDIT_LOG_RETENTION_DAYS": "365",
    "PROFILE_RETENTION_DAYS": "730",
  },
}
