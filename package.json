    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.11.0",
    "next": "^16.2.6",
    "postcss": "^8.5.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
